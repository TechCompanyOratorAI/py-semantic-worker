# Semantic Analysis Configuration
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # ~118MB
# EMBEDDING_MODEL=intfloat/multilingual-e5-small                               # ~118MB
EMBEDDING_MODEL=intfloat/multilingual-e5-base                                  # ~278MB, best quality
# Simple GPU toggle. true requires CUDA; false uses CPU.
ENABLE_GPU=false
# Advanced override: auto, cpu, cuda, gpu. If set, this overrides ENABLE_GPU.
# EMBEDDING_DEVICE=auto
SIMILARITY_THRESHOLD=0.7
BATCH_SIZE=32

# ===== NEW: Speech Quality Analysis Configuration =====
# Enable/disable speech quality analysis
SPEECH_ANALYSIS_ENABLED=true

# openSMILE configuration
OPENSMILE_CONFIG=eGeMAPSv02
SPEECH_SAMPLE_RATE=16000
SPEECH_CHUNK_DURATION=3.0
HESITATION_THRESHOLD=0.3

# ===== NEW: S3 Configuration for Audio Files =====
# S3 bucket and prefix for audio files
AWS_S3_AUDIO_BUCKET=amzn-s3-oratorai
S3_AUDIO_PREFIX=audio/

# Audio file constraints (optional)
MAX_AUDIO_FILE_SIZE_MB=500
AUDIO_FORMAT_VALIDATION=true
AUDIO_TIMESTAMP_VALIDATION=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=colored

# Temp files
TEMP_DIR=/tmp/semantic-worker
CLEANUP_TEMP_FILES=true

