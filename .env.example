# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_SQS_SEMANTIC_QUEUE_URL=

# Database Configuration (MySQL)
# Option 1: Full URL
DATABASE_URL=mysql+pymysql://user:password@host:3306/dbname?ssl=true

# Option 2: Individual parameters (used if DATABASE_URL is not set)
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_DIALECT=mysql

# Worker Configuration
WORKER_ID=semantic-worker-1
POLL_INTERVAL=5
MAX_MESSAGES=1
WAIT_TIME_SECONDS=20

# Webhook Configuration
WEBHOOK_BASE_URL=
# WEBHOOK_BASE_URL=http://localhost:8080/api/v1
WEBHOOK_SECRET=

# Semantic Analysis Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SIMILARITY_THRESHOLD=0.7
BATCH_SIZE=32

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=colored

# Temp files
TEMP_DIR=/tmp/semantic-worker
CLEANUP_TEMP_FILES=true

# Docker Compose - Local MySQL only (profile: localdb)
MYSQL_ROOT_PASSWORD=root_password